# Admin panel env. Only VITE_* vars are bundled.
# Admin runs on its own domain (admin.your-domain.tld), so the API base
# should be a full URL like https://api.your-domain.tld.
VITE_API_BASE=

VITE_PUBLIC_URL=http://localhost:5173
VITE_DEFAULT_LOCALE=ru

# Dev proxy target (server-side only).
VITE_API_PROXY_TARGET=http://localhost:8080
