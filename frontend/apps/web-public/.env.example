# Public site env. Only VITE_* vars are bundled into the browser.
# Same-origin: leave empty; the browser will use window.location.origin.
VITE_API_BASE=

# Where to link "Open admin panel". In dev use http://localhost:5174,
# in prod use https://admin.your-domain.tld.
VITE_ADMIN_URL=http://localhost:5174

VITE_DEFAULT_LOCALE=ru
VITE_ENABLE_SWAGGER=false

# Used by Vite dev-server proxy (server-side only, not exposed).
VITE_API_PROXY_TARGET=http://localhost:8080
