# ============================================================================
# RadarTcell — пример конфигурации.
# Скопируйте в .env и подставьте свои значения.
#   cp .env.example .env
# Значения REPLACE_* обязательно поменяйте перед продакшеном.
# ============================================================================

# ----------------------------- База данных ---------------------------------
# Локальный запуск (go run). Для прода используйте sslmode=require.
DATABASE_URL=postgres://radar_tcell:radar_tcell_password@127.0.0.1:15433/radar_tcell?sslmode=disable
# Используется контейнером app в docker-compose (хост = имя сервиса postgres).
DATABASE_URL_DOCKER=postgres://radar_tcell:radar_tcell_password@postgres:5432/radar_tcell?sslmode=disable
DATABASE_MAX_CONNS=20
POSTGRES_PASSWORD=radar_tcell_password

# ----------------------------- Приложение ----------------------------------
APP_PORT=8080
# development | production
ENV=development

# Если true — Go-сервер также раздаёт `./web/` как SPA (legacy режим).
# В продакшене используйте отдельный nginx для web-public и web-admin.
SERVE_FRONTEND=false

# --------------------------------- Admin ------------------------------------
# Fallback-админ (используется, если в таблице admin_users нет пользователя).
ADMIN_USER=admin
ADMIN_PASSWORD=REPLACE_STRONG_ADMIN_PASSWORD
ADMIN_AUTH_MODE=db_then_env
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
JWT_TTL_HOURS=8
ADMIN_LOGIN_RATE_LIMIT=10

# --------------------------------- Redis ------------------------------------
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=REPLACE_STRONG_REDIS_PASSWORD
REDIS_DB=0

# ------------------------------- Cache TTL ----------------------------------
CATALOG_CACHE_TTL_SECONDS=300
TECHNOLOGY_CACHE_TTL_SECONDS=60

# -------------------------------- Swagger -----------------------------------
# В проде держите false.
SWAGGER_ENABLED=true

# ------------------------------- CORS / CSRF --------------------------------
# Публичный сайт и админка живут на разных доменах — перечисляем оба.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8080
CORS_ALLOWED_HEADERS=Authorization,Content-Type,Accept
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOW_CREDENTIALS=true
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8080

# ------------------------------- Security -----------------------------------
# HSTS включаем ТОЛЬКО за TLS (или nginx с TLS-termination).
SECURITY_HSTS=false
SECURITY_HSTS_MAX_AGE=31536000
# Пусто — используется безопасный дефолт для JSON API + Swagger.
SECURITY_CSP=
SECURITY_FRAME_ANCESTORS='none'
